generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGER
}

enum AttributeType {
  TEXT
  NUMBER
  DROPDOWN
}

model Catalog {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String?
  image       String?

  parentId Int?

  parent   Catalog?  @relation("CatalogTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Catalog[] @relation("CatalogTree")

  products   Product[]
  attributes CatalogAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Attribute {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  type        AttributeType
  description String?
  options     String[]      @default([])

  catalogs CatalogAttribute[]
  values   ProductAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CatalogAttribute {
  id          Int     @id @default(autoincrement())
  catalogId   Int
  attributeId Int
  required    Boolean @default(false)

  catalog   Catalog   @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([catalogId, attributeId])
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String?  @unique
  title       String
  slug        String?  @unique
  price       Float?
  oldPrice    Float?
  description String?
  image       String?
  tag         String?
  subtitle    String?
  warranty    String?
  specs       String[] @default([])

  catalogId Int
  catalog   Catalog @relation(fields: [catalogId], references: [id])

  images     ProductImage[]
  attributes ProductAttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([catalogId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model ProductAttributeValue {
  id          Int    @id @default(autoincrement())
  productId   Int
  attributeId Int
  value       String

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([productId, attributeId])
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  name         String?
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  lastLoginAt DateTime?

  @@index([role, isActive])
}


model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  path       String   @db.VarChar(2048)
  title      String   @db.VarChar(200)
  referrer   String?  @db.VarChar(2048)
  sessionId  String   @db.VarChar(128)
  occurredAt DateTime @default(now())

  @@index([occurredAt])
  @@index([sessionId, occurredAt])
  @@index([path, occurredAt])
}
